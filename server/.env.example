# Server
NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority

# Auth - generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-random-string-at-least-32-characters-long
JWT_EXPIRES_IN=7d

# Client URL for CORS
CLIENT_URL=http://localhost:5173

# Initial admin account (created on first startup if provided)
ADMIN_EMAIL=admin@company.com
ADMIN_PASSWORD=ChangeMe123!
COMPANY_NAME=Acme Corp

# AI integration (optional - choose openai, gemini, or grok)
AI_PROVIDER=openai
AI_API_KEY=
GEMINI_API_KEY=
GROK_API_KEY=
AI_MODEL=
AI_BASE_URL=
